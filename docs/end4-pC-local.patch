+            Rectangle {
+                z: 2
+                visible: root.droppable && !root.newWorkspace
+                anchors.fill: parent
+                color: Looks.colors.accent
+                opacity: 0.2
+            }
+        }
+    }
+
+    // Active indicator
+    WFadeLoader {
+        anchors {
+            horizontalCenter: parent.horizontalCenter
+            bottom: parent.bottom
+        }

diff --git a/modules/waffle/notificationCenter/CalendarGrid.qml b/modules/waffle/notificationCenter/CalendarGrid.qml
new file mode 100644
index 0000000..881705b
--- /dev/null
+++ b/modules/waffle/notificationCenter/CalendarGrid.qml
@@ -0,0 +1,127 @@
+pragma ComponentBehavior: Bound
+import QtQuick
+import QtQuick.Controls
+import QtQuick.Layouts
+import Quickshell
+import qs.modules.waffle.looks
+
+// A minimal month calendar.
+//
+// Qt 6.9 removed the Qt.labs.calendar module (CalendarView / DayOfWeekRow),
+// which the waffle panel family used, so this re-implements just enough of
+// it: a month grid, today highlight and month scrolling.
+Item {
+    id: root
+
+    property var locale: Qt.locale()
+    property int buttonSize: 41
+    property int buttonSpacing: 6
+    property int buttonVerticalSpacing: 1
+    property date focusedDate: new Date()
+
+    readonly property int focusedMonth: focusedDate.getMonth()
+    readonly property int focusedYear: focusedDate.getFullYear()
+
+    function scrollMonthsAndSnap(delta) {
+        var d = new Date(focusedDate.getFullYear(), focusedDate.getMonth() + delta, 1);
+        focusedDate = d;
+    }
+
+    // Short weekday names, starting on the locale's first day of the week.
+    readonly property var weekDayNames: {
+        const names = [];
+        const first = locale.firstDayOfWeek ?? 0;
+        for (let i = 0; i < 7; i++) {
+            names.push(locale.dayName((first + i) % 7, "short"));
+        }
+        return names;
+    }
+
+    // Days of the current month, padded with the neighbouring months' days.
+    readonly property var dayModel: {
+        const model = [];
+        const year = root.focusedYear;
+        const month = root.focusedMonth;
+        const first = root.locale.firstDayOfWeek ?? 0;
+
+        const firstOfMonth = new Date(year, month, 1);
+        const lead = (firstOfMonth.getDay() - first + 7) % 7;
+        const daysInMonth = new Date(year, month + 1, 0).getDate();
+        const daysInPrev = new Date(year, month, 0).getDate();
+
+        for (let i = lead; i > 0; i--) {
+            model.push({ day: daysInPrev - i + 1, month: month - 1, today: false, inMonth: false });
+        }
+        const today = new Date();
+        for (let d = 1; d <= daysInMonth; d++) {
+            model.push({
+                day: d,
+                month: month,
+                today: (today.getFullYear() === year && today.getMonth() === month && today.getDate() === d),
+                inMonth: true
+            });
+        }
+        const trail = (7 - (model.length % 7)) % 7;
+        for (let d = 1; d <= trail; d++) {
+            model.push({ day: d, month: month + 1, today: false, inMonth: false });
+        }
+        return model;
+    }
+
+    implicitWidth: 7 * root.buttonSize + 6 * root.buttonSpacing
+    implicitHeight: 6 * (root.buttonSize + root.buttonVerticalSpacing) + root.buttonSpacing
+
+    RowLayout {
+        id: headerRow
+        Layout.fillWidth: true
+        spacing: root.buttonSpacing
+
+        Repeater {
+            model: root.weekDayNames
+            delegate: Item {
+                required property var modelData
+                Layout.preferredWidth: root.buttonSize
+                Layout.preferredHeight: root.buttonSize
+                WText {
+                    anchors.centerIn: parent
+                    text: {
+                        var result = dayOfWeekItem.modelData;
+                        if (Config.options.waffles.calendar.force2CharDayOfWeek && result.length > 2)
+                            result = result.substring(0, 2);
+                        return result.toUpperCase();
+                    }
+                    color: Looks.colors.fg
+                    font.pixelSize: Looks.font.pixelSize.large
+                }
+            }
+        }
+    }
+
+    GridLayout {
+        id: grid
+        anchors.top: headerRow.bottom
+        anchors.topMargin: root.buttonSpacing
+        anchors.left: parent.left
+        columns: 7
+        rowSpacing: root.buttonVerticalSpacing
+        columnSpacing: root.buttonSpacing
+
+        Repeater {
+            model: root.dayModel
+            delegate: Item {
+                required property var modelData
+                Layout.preferredWidth: root.buttonSize
+                Layout.preferredHeight: root.buttonSize
+
+                WText {
+                    anchors.centerIn: parent
+                    text: dayItem.modelData.day
+                    color: dayItem.modelData.today ? Looks.colors.accent : Looks.colors.fg
+                    font.pixelSize: Looks.font.pixelSize.larger
+                    opacity: dayItem.modelData.inMonth ? 1 : 0.35
+                    font.weight: dayItem.modelData.today ? Looks.font.weight.bold : Looks.font.weight.regular
+                }
+            }
+        }
+    }
+}
diff --git a/modules/waffle/notificationCenter/CalendarWidget.qml b/modules/waffle/notificationCenter/CalendarWidget.qml
new file mode 100644
index 0000000..8b54eae
--- /dev/null
+++ b/modules/waffle/notificationCenter/CalendarWidget.qml
@@ -0,0 +1,101 @@
+pragma ComponentBehavior: Bound
+import QtQml
+import QtQuick
+import QtQuick.Controls
+import QtQuick.Layouts
+import Quickshell
+import qs
+import qs.services
+import qs.modules.common
+import qs.modules.common.widgets
+import qs.modules.common.functions
+import qs.modules.waffle.looks
+
+BodyRectangle {
+    id: root
+
+    // State
+    property bool collapsed
+
+    // Locale
+    property var locale: Qt.locale(Config.options.calendar.locale)
+
+    implicitHeight: collapsed ? 0 : contentColumn.implicitHeight
+    implicitWidth: contentColumn.implicitWidth
+
+    Behavior on implicitHeight {
+        animation: Looks.transition.enter.createObject(this)
+    }
+
+    clip: true
+    ColumnLayout {
+        id: contentColumn
+        spacing: 12
+        CalendarHeader {
+            Layout.topMargin: 10
+            Layout.fillWidth: true
+        }
+        ColumnLayout {
+            Layout.fillWidth: true
+            Layout.leftMargin: 5
+            Layout.rightMargin: 5
+            spacing: 1
+            // Qt 6.9 removed Qt.labs.calendar (CalendarView / DayOfWeekRow),
+            // so CalendarGrid implements the month grid instead.
+            CalendarGrid {
+                id: calendarView
+                locale: root.locale
+                buttonSize: 41 // ???
+                buttonSpacing: 6
+                buttonVerticalSpacing: 1
+                Layout.fillWidth: true
+            }
+        }
+    }
+
+
+
+    component CalendarHeader: RowLayout {
+        Layout.leftMargin: 8
+        Layout.rightMargin: 8
+        spacing: 8
+
+        WBorderlessButton {
+            Layout.fillWidth: true
+            implicitHeight: 34
+            contentItem: Item {
+                WText {
+                    anchors.fill: parent
+                    horizontalAlignment: Text.AlignLeft
+                    text: Qt.locale().toString(calendarView.focusedDate, "MMMM yyyy")
+                    font.pixelSize: Looks.font.pixelSize.large
+                    font.weight: Looks.font.weight.strong
+                }
+            }
+        }
+        ScrollMonthButton {
+            scrollDown: false
+        }
+        ScrollMonthButton {
+            scrollDown: true
+        }
+    }
+
+    component ScrollMonthButton: WBorderlessButton {
+        id: scrollMonthButton
+        required property bool scrollDown
+        Layout.alignment: Qt.AlignVCenter
+
+        onClicked: {
+            calendarView.scrollMonthsAndSnap(scrollDown ? 1 : -1);
+        }
+        implicitWidth: 32
+        implicitHeight: 34
+
+        contentItem: FluentIcon {
+            filled: true
+            implicitSize: 12
+            icon: scrollMonthButton.scrollDown ? "caret-down" : "caret-up"
+        }
+    }
+}

+                            live: true
+                            width: hyprlandWindowData?.size[0] * root.windowScale
+                            height: hyprlandWindowData?.size[1] * root.windowScale
+                            x: hyprlandWindowData?.at[0] * root.windowScale
+                            y: hyprlandWindowData?.at[1] * root.windowScale
+                        }
